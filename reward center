<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Eco Fusion 360 | Reward Center</title>

<style>
:root {
    --bg: #06140e;
    --panel: #0c2418;
    --panel2: #103523;
    --green: #43ff91;
    --mint: #a8ffd0;
    --text: #effff5;
    --muted: #9bb9a7;
    --line: #24523a;
    --gold: #ffd66b;
    --card-hover: #14402a;
}
* { box-sizing: border-box; }

body {
    margin: 0;
    background: radial-gradient(ellipse at 80% 0%, #12482b 0, transparent 35%), var(--bg);
    color: var(--text);
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    min-height: 100vh;
}

header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 5%;
    border-bottom: 1px solid var(--line);
    background: rgba(6, 20, 14, 0.88);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 100;
}

.brand { 
    font-weight: 900; 
    letter-spacing: .5px;
    font-size: 19px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.brand span { color: var(--green); }

.pill {
    border: 1px solid #2d704a;
    border-radius: 999px;
    padding: 8px 16px;
    color: var(--mint);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: rgba(16, 53, 35, 0.4);
}

main {
    max-width: 1180px;
    margin: auto;
    padding: 28px 20px 60px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 22px;
}

.stat, .panel, .reward {
    border: 1px solid var(--line);
    background: linear-gradient(145deg, var(--panel2), var(--panel));
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
}

.stat small { 
    color: var(--muted); 
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

.stat strong {
    display: block;
    font-size: 28px;
    margin-top: 8px;
    color: var(--green);
    font-weight: 800;
}

.panel h2 {
    margin: 0 0 6px;
    font-size: 22px;
    font-weight: 800;
}

.panel p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    margin: 0 0 16px;
}

.profile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
}

.token-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px;
    align-items: end;
}

.field label {
    display: block;
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 7px;
    font-weight: 600;
}

.field input, .field select {
    width: 100%;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #06170f;
    color: var(--text);
    font-size: 14px;
    outline: none;
    transition: border-color .2s, box-shadow .2s;
}

.field input:focus, .field select:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(67, 255, 145, 0.15);
}

.section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 15px;
    margin: 35px 0 15px;
}

.section-head h2 { 
    margin: 0; 
    font-size: 24px; 
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 8px;
}
.section-head p { 
    margin: 6px 0 0; 
    font-size: 13px; 
    color: var(--muted);
}

.progress-track {
    height: 9px;
    background: #07150e;
    border: 1px solid #1a3f2c;
    border-radius: 999px;
    overflow: hidden;
    margin: 12px 0 22px;
}

.progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #1aa356, var(--green));
    transition: width 0.4s ease;
}

.rewards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.reward {
    display: flex;
    flex-direction: column;
    min-height: 310px;
    position: relative;
    overflow: hidden;
    transition: transform .2s, border-color .2s, box-shadow .2s;
}

.reward:hover {
    transform: translateY(-3px);
    border-color: #3b8159;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
}

.reward:before {
    content: "";
    position: absolute;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(67, 255, 145, 0.12) 0%, transparent 70%);
    right: -60px;
    top: -65px;
    pointer-events: none;
}

.reward-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 10px;
    padding-right: 75px;
}

.reward-icon {
    font-size: 26px;
    line-height: 1;
    background: rgba(67, 255, 145, 0.08);
    border: 1px solid #1d4d33;
    padding: 8px;
    border-radius: 12px;
}

.reward h3 { 
    margin: 0; 
    font-size: 18px; 
    font-weight: 800;
    color: var(--text);
    line-height: 1.3;
}

.reward p { 
    font-size: 13px; 
    color: var(--muted);
    margin: 0 0 16px; 
    flex: 1; 
    line-height: 1.5;
}

.cost {
    color: var(--gold);
    font-weight: 800;
    font-size: 14px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    border: 0;
    border-radius: 10px;
    padding: 12px 18px;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
    background: var(--green);
    color: #062012;
    text-decoration: none;
    transition: transform .15s, opacity .15s, filter .15s;
}

.btn:hover { 
    transform: translateY(-1px); 
    filter: brightness(1.08);
}

.btn:disabled { 
    cursor: not-allowed; 
    opacity: .45; 
    transform: none; 
    background: #173b28;
    color: var(--muted);
    border: 1px solid #234c35;
}

.btn.secondary { 
    background: #153d29; 
    color: var(--mint); 
    border: 1px solid #2c6945; 
}
.btn.secondary:hover {
    background: #1d5036;
}

.btn.full { width: 100%; }

.btn.read-now {
    background: linear-gradient(135deg, #43ff91, #18b560);
    color: #041a0e;
    font-weight: 900;
    box-shadow: 0 4px 16px rgba(67, 255, 145, 0.28);
}

.reading-link-wrapper {
    margin-top: 8px;
    text-align: center;
}

.direct-link {
    color: var(--mint);
    font-size: 12px;
    text-decoration: underline;
    opacity: 0.85;
    word-break: break-all;
    display: inline-block;
    padding: 2px 0;
}
.direct-link:hover {
    color: var(--green);
    opacity: 1;
}

.locked-note { 
    font-size: 11px; 
    color: var(--muted); 
    margin-top: 8px; 
    text-align: center;
}

.locked-note.success {
    color: var(--mint);
    font-weight: 600;
}

.tag {
    font-size: 10px;
    color: #06140e;
    background: var(--green);
    padding: 5px 9px;
    border-radius: 999px;
    position: absolute;
    top: 16px;
    right: 16px;
    font-weight: 900;
    letter-spacing: .5px;
}

.tag.unlocked { 
    background: var(--gold); 
    color: #2b1d00;
}

.tag.cert {
    background: #38bdf8;
    color: #041926;
}

.notice {
    font-size: 12.5px;
    border: 1px solid #2a6040;
    border-radius: 12px;
    padding: 12px 14px;
    margin: 14px 0 0;
    color: var(--mint);
    background: rgba(16, 53, 35, 0.25);
    line-height: 1.5;
}

.certificate {
    background: #f8fff8;
    color: #123522;
    border: 9px double #21864b;
    padding: 35px 25px;
    text-align: center;
    border-radius: 12px;
    max-width: 850px;
    margin: 20px auto;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

.certificate h2 {
    color: #176b3c;
    font-size: clamp(24px, 4vw, 38px);
    margin: 12px 0;
    font-weight: 800;
}

.certificate .cert-name {
    font-family: Georgia, serif;
    font-size: clamp(26px, 5vw, 40px);
    border-bottom: 2px solid #4b8c65;
    display: inline-block;
    padding: 6px 30px;
    min-width: 250px;
    color: #104c2b;
    font-weight: bold;
    margin: 8px 0;
}

.certificate p { color: #315a40; font-size: 14px; }

.certificate-tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    max-width: 850px;
    margin: 15px auto;
}

.footer { 
    text-align: center; 
    color: var(--muted); 
    font-size: 12px; 
    margin-top: 45px; 
    line-height: 1.6;
    padding-top: 25px;
    border-top: 1px solid var(--line);
}

@media(max-width: 880px) {
    .rewards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats { grid-template-columns: repeat(3, 1fr); }
}

@media(max-width: 620px) {
    header { padding: 14px 4%; }
    .stats { grid-template-columns: 1fr; }
    .profile-grid, .token-row { grid-template-columns: 1fr; }
    .rewards, .certificate-tools { grid-template-columns: 1fr; }
    main { padding: 18px 14px 40px; }
}

@media print {
    body { background: white !important; color: #123522 !important; }
    .no-print, header, .stats, .panel:not(#certificateArea), #catalogue, .progress-track, #digitalRewardsGrid, #physicalRewardsSection, .footer {
        display: none !important;
    }
    #certificateArea {
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 !important;
        display: block !important;
    }
    main { padding: 0 !important; max-width: none !important; }
    .certificate {
        display: block !important;
        margin: 0 auto !important;
        max-width: 100% !important;
        min-height: 90vh !important;
        padding: 55px !important;
        border: 10px double #21864b !important;
        box-shadow: none !important;
    }
}
</style>
</head>

<body>
<header>
    <div class="brand">🌍 ECO FUSION <span>360</span></div>
    <div class="pill">♻ REWARD CENTER</div>
</header>

<main>

<!-- Top Statistics Row -->
<div class="stats">
    <div class="stat">
        <small>AVAILABLE GREEN TOKENS</small>
        <strong id="statTokens">0</strong>
    </div>

    <div class="stat">
        <small>REWARDS UNLOCKED</small>
        <strong id="statUnlocked">0 / 6</strong>
    </div>

    <div class="stat">
