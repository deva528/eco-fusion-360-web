        badge: "MANGA",
        description: "In a world where magic is everything, Asta was born with no magical power at all. Read official digital chapters on MANGA Plus by Shueisha.",
        url: "https://mangaplus.shueisha.co.jp/titles/100003?utm_source=chatgpt.com",
        linkText: "Read Black Clover on MANGA Plus ↗"
    },
    {
        id: "solo_leveling",
        name: "Solo Leveling",
        category: "manga",
        cost: 600,
        icon: "🗡️",
        badge: "MANGA",
        description: "Follow Sung Jinwoo from the world's weakest E-rank hunter to humanity's greatest shadow sovereign. Official reader release.",
        url: "https://mangaplus.shueisha.co.jp/titles/100003?utm_source=chatgpt.com",
        linkText: "Read Solo Leveling on MANGA Plus ↗"
    },
    {
        id: "jujutsu_kaisen",
        name: "Jujutsu Kaisen",
        category: "manga",
        cost: 800,
        icon: "👹",
        badge: "MANGA",
        description: "Yuji Itadori swallows a legendary cursed talisman and plunges into the dark world of Jujutsu Sorcery. Read official VIZ release.",
        url: "https://www.viz.com/manga-books/manga/jujutsu-kaisen-volume-0-0/product/6537",
        linkText: "Read Jujutsu Kaisen Vol. 0 ↗"
    },
    {
        id: "eco_certificate",
        name: "Eco Champion Certificate",
        category: "certificate",
        cost: 1000,
        icon: "🏅",
        badge: "CERTIFICATE",
        description: "Official Eco Fusion 360 Certificate of Achievement personalized with your name, ecosystem position, and verified token contribution.",
        url: "#certificateArea",
        linkText: "Personalise & Print Certificate 🏅"
    }
];

// App State
let appState = {
    tokens: 0,
    userName: "Eco Champion",
    userEmail: "champion@ecofusion.org",
    unlockedIds: []
};

// LocalStorage Persistence
function loadState() {
    try {
        const saved = localStorage.getItem("ecofusion_reward_state");
        if (saved) {
            const parsed = JSON.parse(saved);
            appState.tokens = typeof parsed.tokens === "number" ? parsed.tokens : 0;
            appState.userName = parsed.userName || "Eco Champion";
            appState.userEmail = parsed.userEmail || "champion@ecofusion.org";
            appState.unlockedIds = Array.isArray(parsed.unlockedIds) ? parsed.unlockedIds : [];
        }
    } catch (e) {
        console.warn("Storage not accessible, using memory state", e);
    }
}

function saveState() {
    try {
        localStorage.setItem("ecofusion_reward_state", JSON.stringify(appState));
    } catch (e) {
        console.warn("Failed to save state", e);
    }
}

function positionFromTokens(n) {
    if (n >= 2000) return 'Eco Guardian';
    if (n >= 1200) return 'Planet Protector';
    if (n >= 700)  return 'Green Champion';
    if (n >= 300)  return 'Eco Explorer';
    return 'Seedling';
}

function renderHeaderStats() {
    document.getElementById("statTokens").textContent = Number(appState.tokens).toLocaleString();
    document.getElementById("statUnlocked").textContent = `${appState.unlockedIds.length} / ${digitalRewards.length}`;
    document.getElementById("statPosition").textContent = positionFromTokens(appState.tokens);

    const userNameInput = document.getElementById("userName");
    const userEmailInput = document.getElementById("userEmail");
    const userTokensInput = document.getElementById("userTokens");
    const certNameInput = document.getElementById("certName");

    if (userNameInput && document.activeElement !== userNameInput) userNameInput.value = appState.userName;
    if (userEmailInput && document.activeElement !== userEmailInput) userEmailInput.value = appState.userEmail;
    if (userTokensInput && document.activeElement !== userTokensInput) userTokensInput.value = appState.tokens;
    if (certNameInput && document.activeElement !== certNameInput) certNameInput.value = appState.userName;

    const progressPercent = Math.min(100, Math.round((appState.unlockedIds.length / digitalRewards.length) * 100));
    document.getElementById("progressBar").style.width = progressPercent + "%";

    updateCertificatePreview();
}

function saveProfile() {
    const nameVal = document.getElementById("userName").value.trim();
    const emailVal = document.getElementById("userEmail").value.trim();
    const tokensVal = parseInt(document.getElementById("userTokens").value, 10);

    appState.userName = nameVal || "Eco Champion";
    appState.userEmail = emailVal || "champion@ecofusion.org";
    appState.tokens = isNaN(tokensVal) || tokensVal < 0 ? 0 : tokensVal;

    saveState();
    renderHeaderStats();
    renderRewardCards();
}

function unlockReward(id) {
    const item = digitalRewards.find(r => r.id === id);
    if (!item) return;

    if (appState.tokens < item.cost) {
        alert(`You need ${item.cost - appState.tokens} more Green Tokens to unlock ${item.name}!`);
        return;
    }

    if (!appState.unlockedIds.includes(id)) {
        appState.unlockedIds.push(id);
        saveState();
        renderHeaderStats();
        renderRewardCards();

        if (item.category === "certificate") {
            openCertificate(item.name);
        }
    }
}

// Render the 6 cards with badges, buttons and links
function renderRewardCards() {
    const container = document.getElementById("digitalRewardsGrid");
    if (!container) return;

    let html = "";

    digitalRewards.forEach((item) => {
        const isUnlocked = appState.unlockedIds.includes(item.id);
        const canUnlock = !isUnlocked && appState.tokens >= item.cost;
        const neededTokens = item.cost - appState.tokens;

        let tagClass = "tag";
        let tagText = item.badge || "DIGITAL";
        if (isUnlocked) {
            tagClass = "tag unlocked";
            tagText = "UNLOCKED ✓";
        } else if (item.category === "certificate") {
            tagClass = "tag cert";
            tagText = "CERTIFICATE";
        }

        let actionHtml = "";
        let noteHtml = "";

        if (isUnlocked) {
            if (item.category === "certificate") {
                actionHtml = `
                    <button class="btn secondary full" type="button" onclick="openCertificate('${item.name}')">
                        🏅 Personalise & Print
                    </button>
                `;
            } else {
                actionHtml = `
                    <a class="btn full read-now" href="${item.url}" target="_blank" rel="noopener noreferrer">
                        📖 Open Reading Link ↗
                    </a>
                `;
            }
            noteHtml = `<div class="locked-note success">✓ Unlocked & saved to account. No second token charge.</div>`;
        } else if (canUnlock) {
            actionHtml = `
                <button class="btn full" type="button" onclick="unlockReward('${item.id}')">
                    Unlock for ${item.cost} Tokens
                </button>
            `;
            noteHtml = `<div class="locked-note">One-time unlock for your Eco Fusion account.</div>`;
        } else {
            actionHtml = `
                <button class="btn full" disabled>
                    Need ${neededTokens} more tokens
                </button>
            `;
            noteHtml = `<div class="locked-note">Earn more Green Tokens to unlock this reward.</div>`;
        }

        html += `
            <article class="reward" id="card-${item.id}">
                <span class="${tagClass}">${tagText}</span>

                <div class="reward-header">
                    <div class="reward-icon">${item.icon}</div>
                    <div>
                        <h3>${item.name}</h3>
                    </div>
                </div>

                <p>${item.description}</p>

                <div class="cost">✦ ${item.cost} Green Tokens</div>

                ${actionHtml}

                <div class="reading-link-wrapper">
                    <a class="direct-link" href="${item.url}" target="_blank" rel="noopener noreferrer" title="${item.url}">
                        ${item.linkText}
                    </a>
                </div>

                ${noteHtml}
            </article>
        `;
    });

    container.innerHTML = html;
}

function updateCertificatePreview() {
    const nameInput = document.getElementById("certName");
    const posSelect = document.getElementById("certPosition");

    const recipientName = (nameInput && nameInput.value.trim()) || appState.userName || "Eco Champion";
    const position = (posSelect && posSelect.value) || positionFromTokens(appState.tokens);

    const namePreview = document.getElementById("certNamePreview");
    const posPreview = document.getElementById("certPositionPreview");
    const tokensPreview = document.getElementById("certTokensPreview");

    if (namePreview) namePreview.textContent = recipientName;
    if (posPreview) posPreview.textContent = position;
    if (tokensPreview) tokensPreview.textContent = Number(appState.tokens).toLocaleString();
}

function openCertificate(title) {
    const certArea = document.getElementById("certificateArea");
    if (!certArea) return;

    certArea.style.display = "block";
    if (title) {
        document.getElementById("certTitle").textContent = title;
    }

    const posSelect = document.getElementById("certPosition");
    if (posSelect) {
        posSelect.value = positionFromTokens(appState.tokens);
    }

    updateCertificatePreview();
    certArea.scrollIntoView({ behavior: "smooth" });
}

function requestPhysicalReward(name, cost) {
    if (appState.tokens < cost) {
        alert(`You need ${cost - appState.tokens} more Green Tokens to request the ${name}.`);
    } else {
        alert(`Request submitted for "${name}"! Our Eco Team will review and ship to your account address.`);
    }
}

document.addEventListener("DOMContentLoaded", function() {
    loadState();
    renderHeaderStats();
    renderRewardCards();

    if (appState.unlockedIds.includes("eco_certificate")) {
        document.getElementById("certificateArea").style.display = "block";
    }
});
</script>

</body>
</html>
