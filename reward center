</div>

<div class="progress-track">
    <div class="progress-bar" id="progressBar"></div>
</div>

<!-- Digital Reward Cards Grid -->
<div class="rewards" id="digitalRewardsGrid">
    <!-- Loaded dynamically below with Haikyu!!, Demon Slayer, Black Clover, Solo Leveling, Jujutsu Kaisen, and Certificate -->
</div>

<!-- Certificate Customization and Print Area -->
<section id="certificateArea" class="panel" style="margin-top: 35px; display: none;">
    <div class="section-head" style="margin-top: 0;">
        <div>
            <h2>🏅 Your Eco Achievement Certificate</h2>
