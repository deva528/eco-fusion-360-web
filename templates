<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EcoSphere AI - Plastics, Health & Planetary Assistant</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="app-container" id="app-container">
    <!-- Left Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <div class="brand-row">
          <div class="brand-badge">
            <div class="leaf-icon">🌱</div>
            <span>EcoSphere AI</span>
          </div>
        </div>
        <button class="btn-new-chat" id="btn-new-chat" title="Start a fresh conversation">
          <span style="display: flex; align-items: center; gap: 0.5rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New Chat
          </span>
          <span class="kbd-badge">Ctrl+K</span>
        </button>
      </div>

      <!-- Conversations History -->
      <div class="sidebar-history" id="history-container">
        <!-- Rendered dynamically -->
      </div>

      <!-- Sidebar Footer -->
      <div class="sidebar-footer">
        <button class="btn-sidebar-nav" id="btn-library">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          Knowledge Library
        </button>
        <button class="btn-sidebar-nav" id="btn-settings">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Settings & Model
        </button>
        <div class="active-engine-badge">
          <div class="engine-pulse"></div>
          <span id="active-engine-label">EcoSphere Offline AI (Active)</span>
        </div>
      </div>
    </aside>

    <!-- Main Chat Workspace -->
    <main class="main-chat">
      <!-- Topbar -->
      <header class="chat-topbar">
        <div class="topbar-left">
          <button class="btn-toggle-sidebar" id="btn-toggle-sidebar">☰</button>
          <select class="model-selector-dropdown" id="model-selector">
            <option value="offline">🌱 EcoSphere Scientific Engine (Offline / Instant)</option>
            <option value="gemini">✨ Google Gemini Live API</option>
            <option value="openai">⚡ OpenAI GPT-4o-mini Live</option>
          </select>
        </div>
        <div class="topbar-actions">
          <button class="btn-icon" id="btn-clear-chat" title="Clear current chat">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
          <button class="btn-icon" id="btn-theme-toggle" title="Toggle dark / light theme">
            <!-- Injected via JS -->
          </button>
        </div>
      </header>

      <!-- Messages Area -->
      <div class="messages-container" id="messages-container">
        <!-- Welcome Screen (Visible on empty chat) -->
        <div class="welcome-screen" id="welcome-screen">
          <div class="welcome-avatar">🌱</div>
          <h1 class="welcome-title">How can I gently assist you today?</h1>
          <p class="welcome-subtitle">
            I am your dedicated environmental companion with deep scientific expertise on plastics, microplastics, and their subtle effects on <strong>human well-being</strong>, <strong>living organisms</strong>, and <strong>plant life</strong>.
          </p>

          <!-- Starter Prompt Cards -->
          <div class="prompt-grid">
            <div class="prompt-card" data-prompt="How do microplastics enter human blood and organs, and what does science know about the health effects?">
              <div class="prompt-card-header">
                <span>🩺</span>
                <span>Human Health & Organs</span>
              </div>
              <div class="prompt-card-text">
                Explore microplastics in human blood, placenta, and how BPA & phthalates affect hormones gently.
              </div>
            </div>

            <div class="prompt-card" data-prompt="How do nanoplastics penetrate plant root membranes, xylem vessels, and the crops we grow?">
              <div class="prompt-card-header">
                <span>🌿</span>
                <span>Plants & Agriculture</span>
              </div>
              <div class="prompt-card-text">
                Understand crack-entry root uptake, xylem translocation, seed germination, and soil mycorrhizae.
              </div>
            </div>

            <div class="prompt-card" data-prompt="How does plastic waste affect marine creatures like turtles, whales, corals, and the marine food chain?">
              <div class="prompt-card-header">
                <span>🐢</span>
                <span>Wildlife & Living Organisms</span>
              </div>
              <div class="prompt-card-text">
                Learn about ingestion, ghost fishing gear, coral disease risks, and bioaccumulation across trophic levels.
              </div>
            </div>

            <div class="prompt-card" data-prompt="What are gentle, realistic daily habits I can adopt to reduce plastic exposure for my health and the earth?">
              <div class="prompt-card-header">
                <span>💡</span>
                <span>Solutions & Hope</span>
              </div>
              <div class="prompt-card-text">
                Discover truly compostable biopolymers (PHA vs PLA), mycelium packaging, and gentle lifestyle choices.
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sticky Input Bar -->
      <footer class="input-section">
        <div class="input-box-wrapper">
          <textarea 
            id="chat-textarea" 
            class="chat-textarea" 
            rows="1" 
            placeholder="Ask anything about plastics, human health, plants, animals, or eco solutions..."
          ></textarea>
          <button class="btn-send" id="btn-send" title="Send message">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </div>
        <div class="input-disclaimer">
          EcoSphere AI combines rigorous peer-reviewed science with gentle guidance. Free, local & private.
        </div>
      </footer>
    </main>
  </div>

  <!-- Settings Modal -->
  <div class="modal-overlay" id="settings-modal">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title">
          <span>⚙️</span>
          <span>Assistant Settings & Models</span>
        </div>
        <button class="btn-modal-close" id="btn-close-settings">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="setting-engine-mode">Active AI Engine</label>
          <select class="form-control" id="setting-engine-mode">
            <option value="offline">🌱 EcoSphere Scientific Engine (Offline, Zero Setup, High Precision)</option>
            <option value="gemini">✨ Google Gemini API (Live Streaming)</option>
            <option value="openai">⚡ OpenAI API (Live Streaming)</option>
          </select>
          <span class="form-help">EcoSphere Offline operates instantly without requiring any API keys.</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="setting-gemini-key">Google Gemini API Key (Optional)</label>
          <input type="password" class="form-control" id="setting-gemini-key" placeholder="AIzaSy...">
          <span class="form-help">Stored locally in your browser. Leave blank to use offline engine.</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="setting-gemini-model">Gemini Model</label>
          <select class="form-control" id="setting-gemini-model">
            <option value="gemini-1.5-flash">Gemini 1.5 Flash (Fast & Gentle)</option>
            <option value="gemini-1.5-pro">Gemini 1.5 Pro (Deep Research)</option>
            <option value="gemini-2.0-flash">Gemini 2.0 Flash</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="setting-openai-key">OpenAI API Key (Optional)</label>
          <input type="password" class="form-control" id="setting-openai-key" placeholder="sk-...">
          <span class="form-help">Stored locally in your browser.</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="setting-openai-model">OpenAI Model</label>
          <select class="form-control" id="setting-openai-model">
            <option value="gpt-4o-mini">GPT-4o Mini</option>
            <option value="gpt-4o">GPT-4o</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="setting-tone-style">Conversational Tone</label>
          <select class="form-control" id="setting-tone-style">
            <option value="gentle">Gentle, Compassionate & Empathetic (Recommended)</option>
            <option value="academic">Academic & In-Depth Scientific</option>
            <option value="concise">Concise & Actionable</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="setting-streaming-speed">Typing Animation Speed (ms per token)</label>
          <input type="number" class="form-control" id="setting-streaming-speed" min="5" max="80" value="20">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-primary" id="btn-save-settings">Save & Apply</button>
      </div>
    </div>
  </div>

  <!-- Knowledge Library Modal -->
  <div class="modal-overlay" id="library-modal">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title">
          <span>📚</span>
          <span>Scientific Knowledge Library</span>
        </div>
        <button class="btn-modal-close" id="btn-close-library">&times;</button>
      </div>
      <div class="modal-body">
        <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 0.5rem;">
          Click any peer-reviewed topic below to instantly converse about it:
        </p>
        <div class="knowledge-list" id="library-list">
          <!-- Injected via JS -->
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="knowledge_base.js"></script>
  <script src="ai_engine.js"></script>
  <script src="app.js"></script>
</body>
</html>
